{
  "name": "yjs-local-collaboration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "yjs",
    "demo"
  ],
  "scripts": {
    "demo": "vite --config ./demo/vite.config.js",
    "demo:build": "vite build --config ./demo/vite.config.js",
    "server": "tsx ./server/index.ts",
    "test:e2e": "tsx ./tests/e2e.js",
    "test:e2e:docker": "docker compose exec demo npm run test:e2e",
    "test:core": "node ./yjs/tests/index.js --repetition-time 50",
    "lint:core": "npm run lint --workspace @y/y",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lib0": "^1.0.0-rc.35",
    "mongodb": "^6.21.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
