{
  "name": "yjs-local-collaboration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "yjs",
    "demo"
  ],
  "scripts": {
    "demo": "vite --config ./demo/vite.config.js",
    "demo:build": "vite build --config ./demo/vite.config.js",
    "server": "node ./server/index.js",
    "test:e2e": "node ./tests/e2e.js",
    "test:e2e:docker": "docker compose exec demo npm run test:e2e",
    "test:core": "node ./yjs/tests/index.js --repetition-time 50",
    "lint:core": "npm run lint --workspace @y/y"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lib0": "^1.0.0-rc.35",
    "mongodb": "^6.21.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.1.0"
  }
}
